APP_MODE=demo
FACILITY_TIMEZONE=Asia/Kolkata
POSTGRES_DB=greenops
POSTGRES_USER=bootstrap
POSTGRES_PASSWORD=GENERATE_LOCALLY
RUNTIME_DB_PASSWORD=GENERATE_LOCALLY
MIGRATOR_DB_PASSWORD=GENERATE_LOCALLY
DATABASE_URL=postgresql+psycopg://greenops:GENERATE_LOCALLY@postgres:5432/greenops
MIGRATION_DATABASE_URL=postgresql+psycopg://greenops_migrator:GENERATE_LOCALLY@postgres:5432/greenops
DATABASE_PREPARE_THRESHOLD=disabled
DATABASE_STATEMENT_TIMEOUT_MS=3000
DATABASE_CONNECT_TIMEOUT_SECONDS=15
# Optional Supabase admin session URL, used only to provision runtime and migrate.
SUPABASE_ADMIN_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
# s3 (MinIO) or azure; credentials remain server-side.
OBJECT_STORAGE_PROVIDER=s3
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=greenops
AZURE_STORAGE_PREFIX=hospital-greenops/
AZURE_STORAGE_CREATE_CONTAINER=false
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=greenops
OBJECT_STORAGE_ACCESS_KEY=greenops-storage
OBJECT_STORAGE_SECRET_KEY=GENERATE_LOCALLY
SESSION_SECRET=GENERATE_LOCALLY
PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
LLM_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_AGENT_MODEL=
LLM_SUPPORTS_TOOLS=true
LLM_SUPPORTS_STREAMING=false
LLM_SUPPORTS_STRICT_SCHEMA=false
LLM_SUPPORTS_PARALLEL_TOOL_CALLS=false
LLM_REASONING_EFFORT=
LLM_TOKEN_LIMIT_PARAMETER=max_completion_tokens
LLM_STREAM_INCLUDE_USAGE=true
LLM_TIMEOUT_SECONDS=45
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_RUN_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=3000
AGENT_AUTONOMOUS_WRITES_ENABLED=false
DEMO_CREDENTIALS_PATH=/app/shared/demo-credentials.json
STARTER_PATH=/app/data/public/starter
JOB_MAX_RETRIES=3
JOB_LEASE_SECONDS=180
